# Server-side Supabase settings. Do not prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional: international digits only, including country calling code (e.g. 216XXXXXXXX).
# This is the public business WhatsApp number used on order confirmation pages.
ADMIN_WHATSAPP_NUMBER=
# Comma-separated Supabase Auth user UUIDs authorized for /admin. Empty denies access.
ADMIN_USER_IDS=
# Required for low-stock warnings; integer quantity threshold in variant units.
ADMIN_LOW_STOCK_THRESHOLD=
# Flouci merchant credentials. Keep both server-side; never prefix either with NEXT_PUBLIC_.
FLOUCI_PUBLIC_KEY=
FLOUCI_PRIVATE_KEY=
# Canonical HTTPS storefront origin used to build Flouci return and webhook URLs.
NEXT_PUBLIC_SITE_URL=https://your-store.example
# Optional secret token used to authenticate automated Vercel Cron jobs.
CRON_SECRET=
